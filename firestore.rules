rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User's shopping list items
      match /ranchoItems/{itemId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(userId);
      }

      // User's purchase history and savings
      match /purchases/{purchaseId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(userId);
      }
    }

    // Connection testing endpoint for app health check
    match /test/connection {
      allow read: if true;
    }
  }
}
